{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "devcontainer", "flux", "terraform"],
  "customManagers": [
    {
      "description": "Container image field in Kubernetes pod specs inside Coder templates",
      "customType": "regex",
      "managerFilePatterns": ["/^coder/templates/.+\\.tf$/"],
      "matchStrings": [
        "\\s+image\\s*=\\s*\"(?<depName>[a-zA-Z0-9./_-]+):(?<currentValue>[a-zA-Z0-9._-]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "CODER_INNER_IMAGE env var value in envbox templates",
      "customType": "regex",
      "managerFilePatterns": ["/^coder/templates/.+\\.tf$/"],
      "matchStrings": [
        "CODER_INNER_IMAGE\"[\\s\\S]{0,80}?value\\s*=\\s*\"(?<depName>[a-zA-Z0-9./_-]+):(?<currentValue>[a-zA-Z0-9._-]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "coder_parameter default values containing Docker images (fallback_image, devcontainer_builder, etc.)",
      "customType": "regex",
      "managerFilePatterns": ["/^coder/templates/.+\\.tf$/"],
      "matchStrings": [
        "\\s+default\\s*=\\s*\"(?<depName>[a-zA-Z0-9][a-zA-Z0-9._-]*\\/[a-zA-Z0-9._/-]+):(?<currentValue>[a-zA-Z0-9._-]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Pinned CLI tool versions passed to templatefile() for coder/templates/*/scripts/install-*.sh.tftpl, marked with a same-line trailing '# renovate: datasource=... depName=...' comment, mirroring Flux's image marker convention (https://fluxcd.io/flux/components/image/imageupdateautomations/#marking-images-for-update)",
      "customType": "regex",
      "managerFilePatterns": ["/^coder/templates/.+\\.tf$/"],
      "matchStrings": [
        "\"(?<currentValue>[a-zA-Z0-9._-]+)\"\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?[ \\t]*(?:\\r?\\n|$)"
      ]
    },
    {
      "description": "Pinned K3s versions in System Upgrade Controller Plans",
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/configs/system-upgrade/k3s-upgrade\\.yaml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*k3s\\s+version:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Pause custom-regex auto-merge until PR Validate Simple / validate is enforced and R0 rules are proven",
      "matchManagers": ["custom.regex"],
      "automerge": false,
      "commitMessagePrefix": "chore(deps): "
    },
    {
      "description": "Pause Terraform minor/patch auto-merge until PR Validate Simple / validate is enforced and R0 rules are proven",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false,
      "commitMessagePrefix": "chore(deps): "
    },
    {
      "description": "codercom enterprise images use ubuntu-YYYYMMDD tags - parse as calendar versioning",
      "matchPackageNames": [
        "codercom/enterprise-base",
        "codercom/enterprise-node",
        "codercom/enterprise-desktop"
      ],
      "versioning": "regex:^ubuntu-(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$"
    }
  ]
}
